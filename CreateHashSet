import java.util.HashSet;

public class CreateHashSet {
    public static void main(String[] args) {
        HashSet<String> fruits = new HashSet<>();

        fruits.add("Apple");
        fruits.add("Banana");
        fruits.add("Mango");
        fruits.add("Orange");

        System.out.println("Fruits in HashSet: " + fruits);
    }
}
OUTPUT:
Fruits in HashSet: [Apple, Mango, Orange, Banana]
